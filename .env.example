# Copy this file to .env before running docker compose.
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=taskmanager
MYSQL_USER=taskapp
MYSQL_PASSWORD=change_me_app_password
MYSQL_PORT=3306

HTTP_PORT=8080
JWT_SECRET=change_me_to_a_random_secret_with_at_least_32_characters
JWT_ISSUER=taskmanager
JWT_TTL=24h
TASK_CACHE_TTL=5m
AUTO_MIGRATE=true
LOG_LEVEL=info
REDIS_PASSWORD=
